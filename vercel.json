{
  "version": 2,
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "devCommand": "npm run dev",
  "functions": {
    "app/api/sources/import/**": {
      "maxDuration": 120,
      "includeFiles": "node_modules/@sparticuz/chromium/bin/**"
    },
    "app/api/sources/tasks/**": {
      "maxDuration": 120,
      "includeFiles": "node_modules/@sparticuz/chromium/bin/**"
    },
    "app/api/cron/sources": {
      "maxDuration": 120,
      "includeFiles": "node_modules/@sparticuz/chromium/bin/**"
    },
    "app/api/cron/source": {
      "maxDuration": 120,
      "includeFiles": "node_modules/@sparticuz/chromium/bin/**"
    }
  },
  "crons": [
    {
      "path": "/api/cron/sources",
      "schedule": "0 1 * * *"
    }
  ]
}
